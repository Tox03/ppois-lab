# ============================================
# C++ and Visual Studio / CMake .gitignore
# ============================================

# Каталоги сборки (CMake / Visual Studio / Ninja)
build/
build_sln/
out/
bin/
lib/
_deps/

# Временные и служебные файлы Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.VC.db
*.VC.opendb

# Промежуточные бинарные файлы и артефакты компиляции
*.obj
*.o
*.ilk
*.pdb
*.tlog
*.idb
*.lastbuildstate
*.unsuccessfulbuild

# Исполняемые файлы и библиотеки
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# Кэш CMake (если запуск был напрямую в корне проекта)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt
!cmake/**

# Временные файлы редакторов и ОС
.vscode/
.idea/
Thumbs.db
.DS_Store
*.tmp
*.log

# Python временные файлы и отчеты покрытия
__pycache__/
*.py[cod]
.coverage
.coverage.*
htmlcov/
*.pytest_cache/
