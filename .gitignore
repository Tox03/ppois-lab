# ============================================
# C++ / Visual Studio / CMake .gitignore
# ============================================

# Каталоги сборки (CMake / Visual Studio / Ninja)
build/
build_sln/
out/
bin/
lib/
_deps/
x64/
x86/
ARM64/
ARM/

# Временные и служебные файлы Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.VC.db
*.VC.opendb
*.vsidx
*.db-shm
*.db-wal

# Промежуточные бинарные файлы и артефакты компиляции
*.obj
*.o
*.ilk
*.pdb
*.tlog
*.idb
*.lastbuildstate
*.unsuccessfulbuild

# Исполняемые файлы и библиотеки
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# Кэш CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt
!cmake/**

# Отчёты о покрытии C++ (OpenCppCoverage)
coverage_html/
lab4_coverage_report/
*.cov

# ============================================
# Python .gitignore
# ============================================

# Байткод и кэши
__pycache__/
*.py[cod]
*$py.class

# Виртуальные окружения
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Дистрибутивы, пакеты и сборка PyInstaller
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# Тестирование и отчёты о покрытии (Coverage / Pytest / Unittest)
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Временные файлы состояния и симуляции завода (ЛР №2)
plant_state.json
**/plant_state.json
**/data/plant_state.json
**/data/*.tmp

# ============================================
# IDE, редакторы кода и операционная система
# ============================================

.idea/
**/.idea/
.vscode/
**/.vscode/
*.swp
*.swo
*~

Thumbs.db
.DS_Store
desktop.ini
*.tmp
*.log

# Временные тестовые сценарии и файлы перенаправления
manual_test_*.txt
test_in.txt
in.txt

# Локальные файлы чеклистов и заданий преподавателя
checklist.md
lab*.md
